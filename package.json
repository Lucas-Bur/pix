{
  "name": "@lucas-bur/pix",
  "version": "0.27.0",
  "description": "Lightweight local semantic project indexer",
  "keywords": [
    "cli",
    "embeddings",
    "local",
    "rag",
    "semantic-search"
  ],
  "homepage": "https://github.com/lucas-bur/pix",
  "bugs": {
    "url": "https://github.com/lucas-bur/pix/issues"
  },
  "license": "MIT",
  "author": "Lucas Burmeister <lucas.burmeister@gmx.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucas-bur/pix.git"
  },
  "bin": {
    "pix": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "bench:retrieval": "vp run bench:retrieval:validate",
    "bench:retrieval:corpus": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/corpus.test.ts",
    "bench:retrieval:corpus-size": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/corpus-size-execution.test.ts",
    "bench:retrieval:corpus-size:model": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/corpus-size-model.test.ts",
    "bench:retrieval:router-models": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/router-model-real.test.ts",
    "bench:retrieval:develop": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/retrieval.test.ts -t \"runs the develop retrieval profile\"",
    "bench:retrieval:fixture": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/channels.test.ts",
    "bench:retrieval:full": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/retrieval.test.ts -t \"runs the full retrieval profile\"",
    "bench:retrieval:matrix": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/matrix-execution.test.ts",
    "bench:retrieval:smoke": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/retrieval.test.ts -t \"runs the smoke retrieval profile\"",
    "bench:retrieval:validate": "vp test --config benchmarks/vite.config.ts --run benchmarks/tests/retrieval.test.ts -t \"runs the validate retrieval profile\"",
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "check": "vp check",
    "ci": "vp run check && vp run test:coverage && vp run build && vp run lint:effect && vp run lint:fallow",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json --format pretty --strict",
    "lint:effect:ci": "effect-tsgo diagnostics --project tsconfig.json --format github-actions --severity error,warning --strict",
    "lint:effect:agent": "effect-tsgo diagnostics --project tsconfig.json --format json --strict",
    "lint:fallow": "fallow",
    "lint:fallow:ci": "vp exec fallow audit --base origin/main",
    "lint:fallow:health": "fallow health --format badge",
    "lint:fallow:agent": "fallow --format json",
    "fallow": "fallow",
    "prepublishOnly": "vp run build",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@sqliteai/sqlite-vector": "1.0.0",
    "tree-sitter": "^0.25.1",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/sql-sqlite-node": "4.0.0-rc.108",
    "@effect/tsgo": "0.36.4",
    "@effect/vitest": "4.0.0-rc.108",
    "@lucas-bur/effect-memfs": "1.2.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.8",
    "effect": "4.0.0-rc.108",
    "fallow": "^3.15.0",
    "ignore": "^7.0.6",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
